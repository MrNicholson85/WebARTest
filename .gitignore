# Dependencies — recreated by `npm install --ignore-scripts`
node_modules/

# Build output — recreated by `npm run build`, and built again by Vercel
dist/

# Vercel CLI local state (project/org linkage, not source)
.vercel/

# Local env files — never commit secrets / API keys
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor clutter
.DS_Store
.idea/
.vscode/*

# NOTE: do NOT ignore *.mind files.
# A compiled target in public/ (e.g. public/my-poster.mind) MUST be
# committed, or Vercel won't serve it and image tracking will 404.
